<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:scrollbarSize="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_small">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:layout_marginBottom="@dimen/card_title_margin_bottom"
                    android:text="@string/title_bmi"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_card_title"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_bmi"
                    android:textSize="@dimen/text_size_card_body"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="@dimen/card_body_margin_bottom"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPatientSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardElevation="@dimen/card_elevation_primary"
            app:rippleColor="?attr/colorOnPrimary">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/margin_standard">
                    <ImageView
                        android:id="@+id/imgPatientIcon"
                        android:layout_width="@dimen/icon_size_nav"
                        android:layout_height="@dimen/icon_size_nav"
                        android:src="@drawable/ic_patient"
                        app:tint="?attr/colorOnPrimary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_standard"
                        android:layout_marginEnd="@dimen/margin_standard">
                        <TextView
                            android:id="@+id/txtPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/easi_patient_not_selected"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="@dimen/text_size_body"
                            android:layout_marginTop="@dimen/margin_micro" />
                    </LinearLayout>
                </LinearLayout>
                <Spinner
                    android:id="@+id/spinnerPazientiNascosto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBmiCalculator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_standard"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bmi_calc_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_card_title"
                    android:textStyle="bold"
                    android:layout_gravity="start"
                    android:layout_marginBottom="@dimen/margin_standard" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/bmi_hint_weight"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="@dimen/margin_small">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/bmi_hint_height"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="@dimen/margin_standard">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutBmiResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/margin_tiny"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/margin_small">

                    <TextView
                        android:id="@+id/txtBmiValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_placeholder_value"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_bmi_value"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBmiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bmi_placeholder_status"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_size_body"
                        android:layout_marginTop="@dimen/margin_micro" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBmiResultScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom_secondary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardElevation="@dimen/card_elevation_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_small"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:layout_marginBottom="@dimen/card_title_margin_bottom">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bmi_result_score_label"
                            android:textSize="@dimen/text_size_result_label"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView
                            android:id="@+id/txtBmiResultScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bmi_placeholder_default"
                            android:textSize="@dimen/text_size_result_value"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bmi_result_severity_label"
                            android:textSize="@dimen/text_size_result_label"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                        <TextView
                            android:id="@+id/txtBmiResultSeverity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bmi_placeholder_default"
                            android:textSize="@dimen/text_size_result_value"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnCalculateBmi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/easi_btn_calculate"
                    android:textColor="?attr/colorOnTertiary"
                    android:backgroundTint="?attr/colorTertiary"
                    app:cornerRadius="@dimen/button_corner_radius"
                    android:layout_marginBottom="@dimen/margin_tiny"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSaveAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nav_padding_horizontal"
            android:layout_marginEnd="@dimen/nav_padding_horizontal"
            android:layout_marginBottom="@dimen/card_margin_bottom_secondary"
            android:paddingTop="@dimen/padding_body"
            android:paddingBottom="@dimen/padding_body"
            android:backgroundTint="?attr/colorSecondary"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/ic_file_save"
            app:iconPadding="@dimen/margin_small"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            android:text="@string/easi_btn_save"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>