<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:paddingTop="@dimen/toolbar_padding_vertical"
        android:paddingBottom="@dimen/toolbar_padding_vertical" >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_text"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_welcome"/>

            <TextView
                android:id="@+id/txtNomeDottoreToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:text="@string/guest_user"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="@dimen/text_size_username" />
        </LinearLayout>
        <ImageView
            android:id="@+id/accountCircle"
            android:layout_width="@dimen/toolbar_account_icon_size"
            android:layout_height="@dimen/toolbar_account_icon_size"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/toolbar_account_icon_margin_end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/toolbar_account_icon_padding"
            android:src="@drawable/ic_account_circle"
            app:tint="?attr/colorOnPrimary"/>
    </androidx.appcompat.widget.Toolbar>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/main_content_description"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_tools_title"
                android:textSize="@dimen/text_size_section_label"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary"
                android:layout_marginBottom="@dimen/section_label_margin_bottom"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin_bottom"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/card_stroke_width"
                app:cardElevation="@dimen/card_elevation">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:id="@+id/baselineCalculate"
                        android:layout_width="@dimen/icon_size_card"
                        android:layout_height="@dimen/icon_size_card"
                        android:background="?attr/colorSecondaryContainer"
                        android:padding="@dimen/icon_padding_card"
                        android:src="@drawable/ic_baseline_calculate"
                        app:tint="?attr/colorSecondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_indices"
                        android:textSize="@dimen/text_size_card_title"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="@dimen/card_title_margin_top"
                        android:layout_marginBottom="@dimen/card_title_margin_bottom"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_indices"
                        android:textSize="@dimen/text_size_card_body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="@dimen/card_body_margin_bottom"/>
                    <Button
                        android:id="@+id/btnCalcola"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_start_calculation"
                        android:textColor="?attr/colorOnSecondary"
                        android:backgroundTint="?attr/colorSecondary"
                        app:cornerRadius="@dimen/button_corner_radius"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/card_margin_bottom_secondary"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardElevation="@dimen/card_elevation_primary" >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">
                    <ImageView
                        android:id="@+id/monitoringIcon"
                        android:layout_width="@dimen/icon_size_card"
                        android:layout_height="@dimen/icon_size_card"
                        android:background="?attr/colorTertiaryContainer"
                        android:padding="@dimen/icon_padding_card"
                        android:src="@drawable/ic_monitoring"
                        app:tint="?attr/colorTertiary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_patient_stats"
                        android:textSize="@dimen/text_size_card_title"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:layout_marginTop="@dimen/card_title_margin_top"
                        android:layout_marginBottom="@dimen/card_title_margin_bottom"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_patient_stats"
                        android:textSize="@dimen/text_size_card_body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="@dimen/card_body_margin_bottom"/>
                    <Button
                        android:id="@+id/btnPatientStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_search_patient"
                        android:textColor="?attr/colorOnTertiary"
                        android:backgroundTint="?attr/colorTertiary"
                        app:cornerRadius="@dimen/button_corner_radius"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/nav_padding_horizontal"
        android:paddingEnd="@dimen/nav_padding_horizontal"
        android:elevation="@dimen/nav_bar_elevation">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:src="@drawable/ic_home"
                android:layout_marginBottom="@dimen/icon_margin_bottom_nav"
                app:tint="?attr/colorSecondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="@dimen/text_size_nav_label"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavPatients"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
            android:layout_width="@dimen/icon_size_nav"
            android:layout_height="@dimen/icon_size_nav"
            android:src="@drawable/ic_patients"
            android:layout_marginBottom="@dimen/icon_margin_bottom_nav"
            app:tint="?attr/colorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_patients"
                android:textSize="@dimen/text_size_nav_label"
                android:textColor="?attr/colorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnReports"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:src="@drawable/ic_reports"
                android:layout_marginBottom="@dimen/icon_margin_bottom_nav"
                app:tint="?attr/colorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_reports"
                android:textSize="@dimen/text_size_nav_label"
                android:textColor="?attr/colorSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnChangeTheme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_nav"
                android:layout_height="@dimen/icon_size_nav"
                android:src="@drawable/ic_contrast"
                android:layout_marginBottom="@dimen/icon_margin_bottom_nav"
                app:tint="?attr/colorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_change_theme"
                android:textSize="@dimen/text_size_nav_label"
                android:textColor="?attr/colorSecondary" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>