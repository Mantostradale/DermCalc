<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:scrollbarSize="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_small">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:layout_marginBottom="@dimen/card_title_margin_bottom"
                    android:text="Calcolo Indice PASI"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_card_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleziona i parametri di gravità (0-4) e l'area coinvolta (0-6) per ciascun distretto corporeo. Spunta 'Zona Esente' se l'area non è interessata."
                    android:textSize="@dimen/text_size_card_body"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="@dimen/card_body_margin_bottom"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Testa (H)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkHeadExempt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zona Esente"
                        android:textColor="#FFFFFF"
                        app:buttonTint="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHeadContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_small">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eritema (Rossore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerHeadErythema" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infiltrazione (Spessore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerHeadInduration" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desquamazione (Squame)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerHeadDesquamation" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area Corporea Coinvolta" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerHeadArea" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/spinner_rounded_item"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tronco (T)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkTrunkExempt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zona Esente"
                        android:textColor="#FFFFFF"
                        app:buttonTint="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutTrunkContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_small">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eritema (Rossore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTrunkErythema" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infiltrazione (Spessore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTrunkInduration" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desquamazione (Squame)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTrunkDesquamation" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area Corporea Coinvolta" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerTrunkArea" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/spinner_rounded_item"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arti Superiori (U)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkUpperExempt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zona Esente"
                        android:textColor="#FFFFFF"
                        app:buttonTint="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutUpperContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_small">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eritema (Rossore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerUpperErythema" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infiltrazione (Spessore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerUpperInduration" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desquamazione (Squame)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerUpperDesquamation" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area Corporea Coinvolta" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerUpperArea" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/spinner_rounded_item"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="@dimen/card_stroke_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arti Inferiori (L)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkLowerExempt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zona Esente"
                        android:textColor="#FFFFFF"
                        app:buttonTint="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLowerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding_small">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eritema (Rossore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLowerErythema" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infiltrazione (Spessore)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLowerInduration" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Desquamazione (Squame)" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLowerDesquamation" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp" android:background="@drawable/spinner_rounded_item"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area Corporea Coinvolta" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="4dp"/>
                    <Spinner android:id="@+id/spinnerLowerArea" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/spinner_rounded_item"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_margin_bottom_secondary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardElevation="@dimen/card_elevation_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_small"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="@dimen/card_title_margin_top"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Punteggio Totale PASI"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnPrimary"
                            android:alpha="0.8"/>
                        <TextView
                            android:id="@+id/txtPasiResultScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classe di Severità"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnPrimary"
                            android:alpha="0.8"/>
                        <TextView
                            android:id="@+id/txtPasiResultSeverity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lieve"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnCalculatePasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calcola Risultato"
                    android:textColor="?attr/colorOnTertiary"
                    android:backgroundTint="?attr/colorTertiary"
                    app:cornerRadius="@dimen/button_corner_radius"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>