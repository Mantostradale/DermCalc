<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_standard"
    android:layout_marginVertical="@dimen/margin_tiny"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:strokeWidth="@dimen/card_stroke_width_small"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSecondaryContainer"
            android:padding="@dimen/margin_small"
            android:text="@string/placeholder_section_title"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_list_title"/>

        <TextView
            android:id="@+id/txtSectionBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_body"
            android:text="@string/placeholder_clinical_data"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_size_body"
            android:lineSpacingMultiplier="1.2"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>